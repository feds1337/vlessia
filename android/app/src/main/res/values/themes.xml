<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The web UI draws everything, edge to edge; the window background
         matches it so there is no flash while it loads. -->
    <style name="Theme.Vlessia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/lagoon</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
